+.portal-admin-manual-topup-toolbar h2,
+.portal-admin-manual-topup-toolbar p {
+  margin: 0;
+}
+
+.portal-admin-manual-topup-metrics {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+}
+
