+}
+
+.portal-admin-manual-topup-metrics strong {
+  color: var(--portal-text-primary);
+  font-size: 1.45rem;
+}
+
+.portal-admin-manual-topup-controls,
+.portal-admin-manual-topup-controls > div,
+.portal-admin-manual-topup-controls form,
+.portal-admin-manual-topup-dialog .portal-inline-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px;
