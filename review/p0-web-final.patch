+def admin_draft(h: Harness, request_id: str, payload: dict) -> str:
+    response = h.admin.post(
+        f"/api/v1/admin/payments/manual/{request_id}/draft",
+        headers={"X-CSRF-Token": h.admin_csrf},
+        json=payload,
