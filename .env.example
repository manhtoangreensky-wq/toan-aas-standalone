# ============================================================
# TOAN AAS Web App — Cấu Hình Môi Trường Mẫu (.env.example)
# ============================================================
# Sao chép file này thành .env và điền các giá trị thực tế.

# === 1. BẮT BUỘC: Bảo mật Session & Cookie ===
# Khóa HMAC ngẫu nhiên 32-64 byte (dùng `python -c "import secrets; print(secrets.token_hex(32))"`)
WEB_SESSION_SECRET=your-random-32-to-64-char-hex-secret-here

# Danh sách Origins được phép (cách nhau bởi dấu phẩy, không có dấu / ở cuối)
# Local: http://localhost:8000
# Production: https://app.toanaas.vn
CORS_ALLOW_ORIGINS=http://localhost:8000

# Bật cookie an toàn (__Host- cookie). Set true trên HTTPS/Production, false trên local dev.
WEB_COOKIE_SECURE=false

# === 2. Cơ sở Dữ liệu (SQLite WAL) ===
# Local: toanaas_webapp_session.db
# Railway Production: /data/toanaas_webapp_session.db (cần tạo Persistent Volume /data)
DB_PATH=toanaas_webapp_session.db
REQUIRE_PERSISTENT_DB=false

# === 3. Xác thực 2 bước (MFA / 2FA TOTP) ===
# Hỗ trợ Google Authenticator, Microsoft Authenticator, 1Password, Authy
WEBAPP_TOTP_MFA_ENABLED=true
# Khóa AES-256 base64url 32 bytes (dùng `python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode('ascii').rstrip('='))"`)
WEBAPP_TOTP_MFA_ENCRYPTION_KEY=your-base64url-32-byte-encryption-key-here

# === 4. Liên kết Tài khoản Telegram Bot ===
# Username của bot Telegram (không có dấu @)
BOT_USERNAME=toanaas_bot
WEBAPP_TELEGRAM_BOT_LINK_ENABLED=true
WEBAPP_TELEGRAM_AUTO_REGISTER_ENABLED=true
# Khóa bí mật đồng bộ giữa Web và Bot cho One-Time Link Code
WEBAPP_LINK_CALLBACK_TOKEN=your-random-hex-token-here
WEBAPP_LINK_CALLBACK_HMAC_SECRET=your-random-hex-secret-here

# === 5. Gửi Email (SMTP) — Xác minh Email & Quên Mật khẩu (Tùy chọn) ===
# Bật khi có SMTP server (ví dụ Gmail App Password, SendGrid, Mailgun)
WEBAPP_EMAIL_VERIFICATION_ENABLED=false
WEBAPP_PASSWORD_RECOVERY_ENABLED=false
# WEBAPP_EMAIL_SMTP_HOST=smtp.gmail.com
# WEBAPP_EMAIL_SMTP_PORT=587
# WEBAPP_EMAIL_SMTP_TLS_MODE=starttls
# WEBAPP_EMAIL_SMTP_USERNAME=your-email@gmail.com
# WEBAPP_EMAIL_SMTP_PASSWORD=your-16-char-app-password
# WEBAPP_EMAIL_VERIFICATION_FROM=noreply@toanaas.vn
# WEBAPP_PUBLIC_BASE_URL=http://localhost:8000

# === 6. Đăng nhập Mạng xã hội (OAuth 2.0 / OIDC) (Tùy chọn) ===
# WEBAPP_PUBLIC_BASE_URL=http://localhost:8000
# WEB_OAUTH_IDENTITY_HMAC_SECRET=your-random-hex-secret-here
# WEBAPP_GOOGLE_OAUTH_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# WEBAPP_GITHUB_OAUTH_ENABLED=false
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# === 7. Core Bridge kết nối Telegram Bot Backend (Tùy chọn) ===
# Đồng bộ ví Xu, cổng PayOS, và các AI job nặng (Midjourney, Kling, Suno, ElevenLabs)
WEBAPP_REQUIRE_CORE_BRIDGE=false
# CORE_BRIDGE_BASE_URL=https://bot-worker.toanaas.vn
# CORE_BRIDGE_TOKEN=your-bridge-bearer-token
# CORE_BRIDGE_HMAC_SECRET=your-bridge-hmac-secret
